{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bridge-lah",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GroupRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroupRoom"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "BOT_USERNAME": "bridge_lah_bot",
    "BOT_APP_SHORT_NAME": "play"
  }
}
